# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string. The database name at the end must be blog_<yourname>, e.g. blog_asha
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/blog_pratush?retryWrites=true&w=majority

# Redis (local Redis, Docker, or a Redis Cloud URL). This project derives the key prefix from the MongoDB database name.
REDIS_URL=redis://localhost:6379
